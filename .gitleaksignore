# Gitleaks ignore file - Whitelist false positives for development secrets
# Format: commit:filepath:pattern:lineNum
# Using * for commit applies to all commits in history
# Pattern is a simplified matcher for the secret string
# See: https://github.com/gitleaks/gitleaks#ignoring-findings

# Development secret in config.py - applies to all commits
*:backend/app/config.py:dev-secret-change-in-production:*

# Test secret placeholders in conftest.py
*:backend/tests/conftest.py:test-secret-key:*
*:backend/tests/conftest.py:test-secret-key-not-for-production-use:*
