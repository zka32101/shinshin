# Gitleaks ignore file - Whitelist false positives for development secrets
# Format: <commit>:<filepath>:<regex pattern>:<line number>
# Using * for commit field applies to all commits (including git history)
# See: https://github.com/gitleaks/gitleaks#ignoring-findings

# Development secret placeholder in config.py (appears in git history)
*:backend/app/config.py:secret_key:\s*=\s*["\']dev-secret-change-in-production["\']:*

# Test secret placeholder in conftest.py
*:backend/tests/conftest.py:test-secret-key-not-for-production-use-[a-z0-9]+:*

# Also ignore the old test secret format that may be in history
*:backend/tests/conftest.py:test-secret-key-for-unit-tests-only:*
