# Backend environment variables — copy to .env and fill in values

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shougaku

# JWT
SECRET_KEY=dev-secret-change-in-production-must-be-32-chars-minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Firebase (leave empty to skip Firebase auth in local dev)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# App
DEBUG=true
ENVIRONMENT=development

# Optional: Sentry error tracking
# SENTRY_DSN=https://...@sentry.io/...

# Vertex AI (Gemini) - 親向けAIコーチング
GCP_PROJECT_ID=
VERTEX_AI_LOCATION=asia-northeast1
GEMINI_MODEL_ID=gemini-2.0-flash

# SendGrid - メール送信
SENDGRID_API_KEY=

# ── 課金レシート検証 ──────────────────────────────────────────────
# Google Play Developer API（Android購読の検証）
# サービスアカウントJSON鍵ファイルへのパス（Play Console > API アクセス で発行）
GOOGLE_PLAY_CREDENTIALS_PATH=
# Androidアプリのパッケージ名
GOOGLE_PLAY_PACKAGE_NAME=jp.petitworks.shougaku_kore_doutoku

# App Store Server API（iOS購読の検証）
# App Store Connect > ユーザーとアクセス > キー で発行するチームキー
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_BUNDLE_ID=jp.petitworks.shougaku_kore_doutoku
# .p8 秘密鍵ファイル（PEM形式, ES256署名用）へのパス
APPLE_PRIVATE_KEY_PATH=
# "production" または "sandbox"（TestFlight/開発中は sandbox）
APPLE_ENVIRONMENT=production
