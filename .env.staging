# ========================================================
# ステージング環境設定 (.env.staging)
# 使用対象: TestFlight / Google Play Internal Testing
# ========================================================

# ========================================================
# Firebase 設定（ステージングプロジェクト）
# ========================================================
FIREBASE_PROJECT_ID=shougaku-kore-doutoku-staging
FIREBASE_API_KEY=YOUR_STAGING_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=shougaku-kore-doutoku-staging.firebaseapp.com
FIREBASE_STORAGE_BUCKET=shougaku-kore-doutoku-staging.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_STAGING_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_STAGING_APP_ID

# Firebase Emulator（ステージングでは無効）
USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_PORT=
FIRESTORE_EMULATOR_PORT=
STORAGE_EMULATOR_PORT=

# ========================================================
# API 設定（ステージング環境）
# ========================================================
API_BASE_URL=https://staging-api.shougaku-kore.jp
API_TIMEOUT_SECONDS=30

# ========================================================
# 機能フラグ（ステージングはほぼ本番と同じ）
# ========================================================
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_AUDIO_NARRATION=true
ENABLE_PARENT_REPORTS=true
ENABLE_DEBUG_MODE=false

# ========================================================
# ログ設定
# ========================================================
LOG_LEVEL=info
ENABLE_STRUCTURED_LOGGING=true
# 本番と同じ環境でテストするため Sentry を有効化
ENABLE_SENTRY_REPORTING=true

# Sentry（ステージング環境）
SENTRY_DSN=https://your_staging_sentry_dsn@sentry.io/your_project_id
SENTRY_ENVIRONMENT=staging
SENTRY_TRACE_SAMPLE_RATE=1.0

# ========================================================
# アプリ設定
# ========================================================
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
APP_ENVIRONMENT=staging

# ========================================================
# ローカライゼーション
# ========================================================
DEFAULT_LANGUAGE=ja
SUPPORTED_LANGUAGES=ja,en

# ========================================================
# ステージング専用設定
# ========================================================
# 外部テスターを識別（レポートに含める）
TESTER_MODE=true

# エラーレポート：ステージングでも全て送信
REPORT_ALL_ERRORS=true

# TestFlight ビルドであることを示す
TESTFLIGHT_BUILD=true
