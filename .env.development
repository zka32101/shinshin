# ========================================================
# 開発環境設定 (.env.development)
# 使用対象: flutter run (ローカル開発)
# ========================================================

# ========================================================
# Firebase 設定（開発プロジェクト）
# ========================================================
FIREBASE_PROJECT_ID=shougaku-kore-doutoku-dev
FIREBASE_API_KEY=YOUR_DEV_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=shougaku-kore-doutoku-dev.firebaseapp.com
FIREBASE_STORAGE_BUCKET=shougaku-kore-doutoku-dev.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_DEV_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_DEV_APP_ID

# Firebase Emulator（開発専用）
# ローカルで Firebase Emulator Suite を実行している場合
USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=localhost
FIREBASE_AUTH_EMULATOR_PORT=9099
FIRESTORE_EMULATOR_PORT=8080
STORAGE_EMULATOR_PORT=4000

# ========================================================
# API 設定
# ========================================================
API_BASE_URL=http://localhost:8000
API_TIMEOUT_SECONDS=30

# ========================================================
# 機能フラグ（開発環境では全て有効）
# ========================================================
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_AUDIO_NARRATION=true
ENABLE_PARENT_REPORTS=true
ENABLE_DEBUG_MODE=true

# ========================================================
# ログ設定
# ========================================================
LOG_LEVEL=debug
ENABLE_STRUCTURED_LOGGING=true
ENABLE_SENTRY_REPORTING=false

# Sentry（開発では無効）
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACE_SAMPLE_RATE=1.0

# ========================================================
# アプリ設定
# ========================================================
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
APP_ENVIRONMENT=development

# ========================================================
# ローカライゼーション
# ========================================================
DEFAULT_LANGUAGE=ja
SUPPORTED_LANGUAGES=ja,en

# ========================================================
# 開発者専用設定
# ========================================================
# ダミーユーザーでのテストを有効化
ENABLE_TEST_USERS=true

# Riverpod DevTools 有効化
ENABLE_RIVERPOD_DEVTOOLS=true

# ホットリロード時に状態をリセット
RESET_STATE_ON_HOT_RELOAD=false
