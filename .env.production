# ========================================================
# 本番環境設定 (.env.production)
# 使用対象: App Store / Google Play 本番リリース
# ⚠️ SENSITIVE: 本番環境の秘密情報が含まれます
# ========================================================

# ========================================================
# Firebase 設定（本番プロジェクト）
# ========================================================
FIREBASE_PROJECT_ID=shougaku-kore-doutoku
FIREBASE_API_KEY=YOUR_PRODUCTION_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=shougaku-kore-doutoku.firebaseapp.com
FIREBASE_STORAGE_BUCKET=shougaku-kore-doutoku.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_PRODUCTION_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_PRODUCTION_APP_ID

# Firebase Emulator（本番では無効）
USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_PORT=
FIRESTORE_EMULATOR_PORT=
STORAGE_EMULATOR_PORT=

# ========================================================
# API 設定（本番環境）
# ========================================================
API_BASE_URL=https://api.shougaku-kore.jp
API_TIMEOUT_SECONDS=30

# ========================================================
# 機能フラグ（本番は全て有効）
# ========================================================
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_AUDIO_NARRATION=true
ENABLE_PARENT_REPORTS=true
ENABLE_DEBUG_MODE=false

# ========================================================
# ログ設定
# ========================================================
LOG_LEVEL=warn
ENABLE_STRUCTURED_LOGGING=true
ENABLE_SENTRY_REPORTING=true

# Sentry（本番環境）
SENTRY_DSN=https://your_production_sentry_dsn@sentry.io/your_project_id
SENTRY_ENVIRONMENT=production
SENTRY_TRACE_SAMPLE_RATE=0.1

# ========================================================
# アプリ設定
# ========================================================
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
APP_ENVIRONMENT=production

# ========================================================
# ローカライゼーション
# ========================================================
DEFAULT_LANGUAGE=ja
SUPPORTED_LANGUAGES=ja,en

# ========================================================
# 本番環境専用設定
# ========================================================
# 本番環境ではテストモードを無効化
TESTER_MODE=false

# 本番環境では意図しないエラーのみレポート
REPORT_ALL_ERRORS=false

# 本番ビルド
TESTFLIGHT_BUILD=false

# ========================================================
# セキュリティ関連（⚠️ 機密情報）
# ========================================================
# GitHub Actions からのビルドの場合、以下は環境変数に
# セットされます（このファイルには記載しません）
#
# KEYSTORE_PASSWORD=... (GitHub Secret)
# KEYSTORE_ALIAS=... (GitHub Secret)
# KEYSTORE_KEY_PASSWORD=... (GitHub Secret)
# IOS_CERTIFICATE_P12_BASE64=... (GitHub Secret)
# IOS_PROVISIONING_PROFILE_BASE64=... (GitHub Secret)
# IOS_CERTIFICATE_PASSWORD=... (GitHub Secret)
# IOS_TEAM_ID=... (GitHub Secret)

# ========================================================
# 重要なセキュリティ注意事項
# ========================================================
# ❌ このファイルに本番環境の秘密情報を直接記載しない
# ❌ .env.production を git にコミットしない
# ✅ GitHub Actions で環境変数を使用してビルド
# ✅ Firebase console でセキュリティルールを適用
# ✅ 定期的にキーとトークンをローテーション
